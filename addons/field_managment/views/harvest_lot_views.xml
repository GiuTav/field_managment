<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_harvest_lot_list" model="ir.ui.view">
        <field name="name">farm.harvest.lot.list</field>
        <field name="model">farm.harvest.lot</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="field_id"/>
                <field name="crop_cycle_id"/>
                <field name="product_id"/>
                <field name="quantity_kg"/>
                <field name="quality_grade"/>
                <field name="destination"/>
            </list>
        </field>
    </record>

    <record id="view_farm_harvest_lot_form" model="ir.ui.view">
        <field name="name">farm.harvest.lot.form</field>
        <field name="model">farm.harvest.lot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="field_id"/>
                            <field name="crop_cycle_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="quantity_kg"/>
                            <field name="quality_grade"/>
                            <field name="destination"/>
                            <field name="operator_id"/>
                            <field name="stock_lot_id"/>
                            <field name="traceability_url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Processing Lots">
                            <field name="processing_lot_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
