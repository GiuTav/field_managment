<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_field_list" model="ir.ui.view">
        <field name="name">farm.field.list</field>
        <field name="model">farm.field</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="area_ha"/>
                <field name="soil_type"/>
                <field name="cultivation_method"/>
                <field name="current_crop_cycle_id"/>
                <field name="responsible_id"/>
            </list>
        </field>
    </record>

    <record id="view_farm_field_form" model="ir.ui.view">
        <field name="name">farm.field.form</field>
        <field name="model">farm.field</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="area_ha"/>
                            <field name="soil_type"/>
                            <field name="cultivation_method"/>
                            <field name="irrigation_available"/>
                        </group>
                    </group>
                    <group string="Location">
                        <field name="latitude"/>
                        <field name="longitude"/>
                    </group>
                    <notebook>
                        <page string="Crop Cycles">
                            <field name="crop_cycle_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="state"/>
                                    <field name="date_start"/>
                                    <field name="expected_harvest_date"/>
                                    <field name="harvested_qty_kg"/>
                                    <field name="yield_kg_ha"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
