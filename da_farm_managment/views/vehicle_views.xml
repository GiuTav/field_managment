<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_da" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.da</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <field name="odometer" position="after">
                <field name="da_hourly_cost"/>
                <field name="da_cost_per_km"/>
            </field>
        </field>
    </record>

    <record id="view_da_vehicle_fuel_log_list" model="ir.ui.view">
        <field name="name">da.vehicle.fuel.log.list</field>
        <field name="model">da.vehicle.fuel.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="odometer_value"/>
                <field name="liters" sum="Liters"/>
                <field name="total_cost" sum="Cost"/>
                <field name="cost_per_liter"/>
                <field name="supplier_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_da_vehicle_fuel_log_form" model="ir.ui.view">
        <field name="name">da.vehicle.fuel.log.form</field>
        <field name="model">da.vehicle.fuel.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="date"/>
                            <field name="odometer_value"/>
                        </group>
                        <group>
                            <field name="liters"/>
                            <field name="total_cost"/>
                            <field name="cost_per_liter"/>
                            <field name="supplier_id"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_da_vehicle_fuel_log" model="ir.actions.act_window">
        <field name="name">Fuel and Odometer Logs</field>
        <field name="res_model">da.vehicle.fuel.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_da_vehicle_maintenance_plan_list" model="ir.ui.view">
        <field name="name">da.vehicle.maintenance.plan.list</field>
        <field name="model">da.vehicle.maintenance.plan</field>
        <field name="arch" type="xml">
            <list decoration-danger="due_status == 'due'" decoration-warning="due_status == 'due_soon'">
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="current_odometer"/>
                <field name="next_due_date"/>
                <field name="next_due_odometer"/>
                <field name="due_status" widget="badge"/>
                <field name="responsible_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_da_vehicle_maintenance_plan_form" model="ir.ui.view">
        <field name="name">da.vehicle.maintenance.plan.form</field>
        <field name="model">da.vehicle.maintenance.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_serviced" type="object" string="Mark Serviced" class="btn-primary"/>
                    <field name="due_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vehicle_id"/>
                            <field name="responsible_user_id"/>
                        </group>
                        <group>
                            <field name="interval_days"/>
                            <field name="interval_km"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Service Thresholds">
                        <group>
                            <field name="last_service_date"/>
                            <field name="next_due_date"/>
                        </group>
                        <group>
                            <field name="last_service_odometer"/>
                            <field name="current_odometer"/>
                            <field name="next_due_odometer"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_da_vehicle_maintenance_plan" model="ir.actions.act_window">
        <field name="name">Vehicle Maintenance Plans</field>
        <field name="res_model">da.vehicle.maintenance.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
